# Copy this file to .env and adjust values before running docker compose.

# Node identity
NODE_ID=dev-node-1

# MariaDB
MARIADB_ROOT_PASSWORD=aether_root_changeme
MARIADB_DATABASE=aethernet
MARIADB_USER=aethernet
MARIADB_PASSWORD=aether_pass_changeme
MARIADB_PORT=3306

# Redis
REDIS_PASSWORD=aether_redis_changeme
REDIS_PORT=6379

# Ports exposed on the host
PANEL_PORT=8080
DAEMON_HTTP_PORT=8081
GRPC_PORT=7001
RAFT_PORT=7000
SFTP_PORT=2022

# Set to "true" only on the FIRST node of a new cluster.
# All subsequent nodes should set this to "false" and provide a JOIN_ADDR.
BOOTSTRAP=true
JOIN_ADDR=
JOIN_TOKEN=
